{
  "name": "scdmg",
  "private": true,
  "version": "0.1.0",
  "description": "Cartoon sci-fi skirmish miniatures game for the browser (working codename SCDMG).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "sim": "node -e \"process.env.VITEST_SIM=1;require('child_process').execSync('npx vitest run --reporter=verbose',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
